{
  "name": "claude-code-task-tracker",
  "version": "0.13.2",
  "description": "終端機 TUI，即時追蹤 Claude Code 自己開出來的 task（TodoWrite / Tasks API）",
  "type": "module",
  "license": "MIT",
  "author": "gogogohuang <gogogohuang@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gogogohuang/claude-code-task-tracker.git"
  },
  "homepage": "https://github.com/gogogohuang/claude-code-task-tracker#readme",
  "bugs": {
    "url": "https://github.com/gogogohuang/claude-code-task-tracker/issues"
  },
  "keywords": [
    "claude-code",
    "cli",
    "tui",
    "task-tracker"
  ],
  "bin": {
    "task-tracker": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts src/inspect/*.test.ts src/workflow/*.test.ts src/ui/*.test.ts src/usage/*.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "tsup": "^8.1.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.11.0"
}
